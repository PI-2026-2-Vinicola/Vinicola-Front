# Endereço da API OASIS em produção (ex.: https://api.suaempresa.com.br).
# Vazio = mesma origem do site; em desenvolvimento o Vite encaminha /api para http://localhost:8000.
VITE_API_URL=
# Subdiretório de publicação (ex.: /oasis/)
VITE_BASE=/

# ThingSpeak e Embrapa AgroAPI NÃO são configurados aqui: tudo o que vai no build do frontend fica
# visível no navegador. As chaves ficam somente no .env da API (Vinicola-back), que faz as consultas.
